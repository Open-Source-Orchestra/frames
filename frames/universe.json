{
  "$schema": "https://frames.opensourceorchestra.org/schema/frame-0.1.json",
  "frame": "osoframes/0.1",
  "id": "oso-universe",
  "name": "The Open Source Orchestra universe",
  "credit": {
    "add": []
  },
  "license": {
    "data": "CC-BY-SA-4.0",
    "code": "AGPL-3.0-or-later"
  },
  "strings": {},
  "slots": {
    "top-left": [
      {
        "kind": "globe",
        "id": "globe",
        "tip": "Choose your language. The page and the frame follow you."
      }
    ],
    "left": [
      {
        "kind": "theater",
        "id": "theater",
        "label": "Theater",
        "href": "https://osodaomeet.opensourceorchestra.org/",
        "channels": "https://osodaomeet.opensourceorchestra.org/data/channels.json",
        "video": {
          "src": "../media/walkthrough.mp4",
          "poster": "../media/walkthrough.jpg",
          "captions": "../media/walkthrough.vtt",
          "duration": "45 s"
        },
        "tip": "The theater: films and calls of the orchestra, shared with consent.",
        "unless": "window.__osoTV"
      },
      {
        "kind": "door",
        "id": "songbook",
        "emoji": "🎼",
        "label": "Songbook",
        "href": "https://shakaleikaumaka.com/songbook/",
        "tip": "Story-songs of the ʻohana, free for anyone to sing.",
        "anim": "bob"
      },
      {
        "kind": "door",
        "id": "kala",
        "emoji": "🪕",
        "label": "Kala on the road",
        "href": "https://shakaleikaumaka.com/kala/",
        "tip": "The Kala ukulele and U·BASS at Devcon 8, in the official photos.",
        "anim": "sway"
      },
      {
        "kind": "door",
        "id": "garden-circle",
        "emoji": "🌺",
        "label": "Garden Circle",
        "href": "https://opensourceorchestra.org/garden/circle/",
        "tip": "Not a stage: a circle on the floor, with room for everyone.",
        "anim": "pulse"
      },
      {
        "kind": "door",
        "id": "mandala-room",
        "emoji": "🦋",
        "label": "The Mandala Room",
        "href": "https://opensourceorchestra.org/mandala-room/",
        "tip": "Four days of the Devcon 8 music sanctuary, in official photos.",
        "anim": "flutter"
      },
      {
        "kind": "door",
        "id": "nodes",
        "emoji": "💻",
        "label": "Nodes",
        "href": "https://opensourceorchestra.org/nodes/",
        "tip": "Every voice is a node: the artists of the orchestra and their songs.",
        "anim": "bob"
      },
      {
        "kind": "door",
        "id": "camera",
        "emoji": "📸",
        "label": "Camera",
        "href": "https://opensourceorchestra.org/camera/",
        "tip": "Photos, films and voices from the Devcon 8 music sanctuary.",
        "anim": "pulse"
      },
      {
        "kind": "door",
        "id": "pit",
        "emoji": "📡",
        "label": "PIT Standard",
        "href": "https://publicinform.com/spec/v2/",
        "tip": "An open standard: a room that remembers honestly, consent first.",
        "anim": "sway"
      },
      {
        "kind": "door",
        "id": "fork-the-first-artist",
        "emoji": "🎨",
        "label": "Fork the first artist",
        "href": "https://artist.opensourceorchestra.org/",
        "tip": "A home for any artist, built in the open. Fork it for yours.",
        "anim": "spin"
      }
    ],
    "bottom-left": [
      {
        "kind": "pill",
        "id": "lisbon",
        "emoji": "🦄",
        "title": "Devcon IX · Lisbon",
        "sub": "12–14 October 2027",
        "href": "https://opensourceorchestra.org/join/",
        "tip": "The road to Devcon IX in Lisbon, 12–14 October 2027. Anyone can join."
      },
      {
        "kind": "pill",
        "id": "mandala",
        "emoji": "🦋",
        "title": "The Mandala Room",
        "sub": "Devcon 8 ✓ · next: Lisbon",
        "href": "https://opensourceorchestra.org/mandala-room/",
        "tone": "gold",
        "dismiss": true,
        "tip": "Devcon 8 is done and remembered. Next stop: Lisbon."
      }
    ],
    "top-right": [
      {
        "kind": "door",
        "id": "orchestra",
        "emoji": "🎻",
        "label": "Open Source Orchestra",
        "href": "https://opensourceorchestra.org/",
        "tip": "Home of the Open Source Orchestra: music as sanctuary, open to all.",
        "anim": "sway"
      },
      {
        "kind": "tour",
        "id": "tour",
        "emoji": "✨",
        "label": "Tour",
        "video": {
          "src": "../media/walkthrough.mp4",
          "poster": "../media/walkthrough.jpg",
          "captions": "../media/walkthrough.vtt",
          "duration": "45 s"
        },
        "tip": "Replay this tour any time, and watch the walkthrough."
