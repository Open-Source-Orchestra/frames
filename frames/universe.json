        "route": "prefix",
        "faces": [
          {
            "k": "shaka",
            "n": "SHAKA",
            "e": "🤙",
            "c": "#ffb443"
          },
          {
            "k": "oso",
            "n": "OSO",
            "e": "🎻",
            "c": "#ff7eb6"
          },
          {
            "k": "deva",
            "n": "DEVA",
            "e": "🦄",
            "c": "#c792ea"
          },
          {
            "k": "crops",
            "n": "CROPS",
            "e": "🌿",
            "c": "#2f9e6f"
          },
          {
            "k": "kala",
            "n": "KALA",
            "e": "🪕",
            "c": "#f7d794"
          },
          {
            "k": "oke",
            "n": "OKE",
            "e": "💙",
            "c": "#4fc3f7"
          }
        ],
        "tip": "Six agents of the ʻohana. Tap a face to talk. They are AI, and they say so."
      },
      {
        "kind": "door",
        "id": "shaka",
        "emoji": "🤙",
        "label": "Shaka",
        "href": "https://shakaleikaumaka.com/",
        "tip": "The front door of Shaka Lei Kaumaka, the musician who tends the orchestra.",
        "anim": "sway"
      },
      {
        "kind": "door",
        "id": "all-doors",
        "emoji": "🧭",
        "label": "All doors",
        "href": "https://myagentohana.com/doors/",
        "tip": "Every public door of the ʻohana, in one searchable atlas.",
        "anim": "spin"
      },
      {
        "kind": "door",
        "id": "public-goods",
        "emoji": "🎁",
        "label": "Public goods",
        "href": "https://opensourceorchestra.org/dao/",
        "tip": "The open ledger and the public goods shelf: everything in the open.",
        "anim": "pulse"
      },
      {
        "kind": "door",
        "id": "schedule",
        "emoji": "🗓️",
        "label": "Schedule",
        "href": "https://opensourceorchestra.org/schedule/",
        "tip": "The Devcon 8 music schedule, 3–6 November 2026, as it happened.",
        "anim": "bob"
      },
      {
        "kind": "door",
        "id": "calls",
        "emoji": "📞",
        "label": "Calls",
        "href": "https://opensourceorchestra.org/calls/",
        "tip": "The weekly calls of the orchestra, recorded with everyone's consent.",
        "anim": "sway"
      },
      {
        "kind": "door",
        "id": "fork-this-frame",
        "emoji": "🍴",
        "label": "Fork this frame",
        "href": "https://github.com/Open-Source-Orchestra/frames",
        "tip": "Fork this frame for your own site. The credit travels; every fork stays open.",
        "anim": "spin"
      }
    ],
    "bottom-right": [
      {
        "kind": "chat",
        "id": "chat",
        "label": "Talk to OSO",
        "name": "OSO",
        "emoji": "🎻",
        "hub": "https://chat.opensourceorchestra.org",
        "storage": "oso",
        "greeting": "Aloha! I am an AI agent of the ʻohana, here for the Open Source Orchestra. Ask me anything about the music, the circle, or how to join.",
        "tip": "A live line to an AI agent of the orchestra. Replies take a moment.",
        "unless": "#oso-fab, #oso-mini"
      },
      {
        "kind": "radio",
        "id": "radio",
        "label": "Radio",
        "tracks": [
          {
            "title": "Butterflies and Love",
            "artist": "Shaka Lei Kaumaka",
            "src": "https://shakaleikaumaka.com/radio-assets/i-open-sourced-my-whole-universe.mp3",
            "license": "CC0-1.0, as gifted on shakaleikaumaka.com/radio/"
          },
          {
            "title": "A Planet We Share As One",
            "artist": "Shaka Lei Kaumaka",
            "src": "https://shakaleikaumaka.com/radio-assets/a-planet-we-share-as-one.mp3",
            "license": "CC0-1.0, as gifted on shakaleikaumaka.com/radio/"
          },
          {
            "title": "Be My Friend",
            "artist": "Matteo Tambussi",
            "src": "https://shakaleikaumaka.com/radio-assets/matteo-tambussi--be-my-friend.mp3",
