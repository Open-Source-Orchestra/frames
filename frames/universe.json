          },
          {
            "title": "Island",
            "artist": "Matteo Tambussi",
            "src": "https://shakaleikaumaka.com/radio-assets/matteo-tambussi--island.mp3",
            "license": "the artist's own terms; ask the artist before reuse"
          }
        ],
        "live": {
          "status": "https://live.zuchiangmai.app/api/rt/status",
          "page": "https://live.zuchiangmai.app/"
        },
        "tip": "Songs shared with the artists' consent. Nothing plays until you press play.",
        "unless": "#miniplayer"
      }
    ],
    "overlay": [
      {
        "kind": "signature",
        "id": "signature",
        "src": "../media/signature.svg",
        "at": "bottom-right",
        "by": "Shaka Lei Kaumaka",
        "duration": 2800,
        "delay": 1200,
        "width": 210
      }
    ]
