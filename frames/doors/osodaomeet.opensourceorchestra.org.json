          "anim": "pulse"
        },
        {
          "kind": "door",
          "id": "watch",
          "emoji": "🍿",
          "label": "Watch",
          "href": "https://osodaomeet.opensourceorchestra.org/watch/",
          "tip": "PIT Theater: Season 1, six episodes, films and recordings.",
          "anim": "bob"
        }
      ],
      "remove": [
        "theater"
      ]
    },
    "right": {
      "remove": [
        "calls"
      ]
    }
  }
