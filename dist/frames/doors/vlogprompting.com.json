{
  "$schema": "https://frames.opensourceorchestra.org/schema/frame-0.1.json",
  "frame": "osoframes/0.1",
  "extends": "../universe.json",
  "host": "vlogprompting.com",
  "id": "vlog-prompting",
  "name": "Vlog Prompting",
  "emoji": "🎬",
  "accent": "#7ee2a0",
  "description": "Talk to camera, not to keyboard: record in your browser, get an instant transcript, agents act.",
  "slots": {
    "left": {
      "prepend": [
        {
          "kind": "door",
          "id": "home",
          "emoji": "🎬",
          "label": "Vlog Prompting",
          "href": "https://vlogprompting.com/",
          "tip": "Talk to camera, not to keyboard.",
          "anim": "pulse"
        },
        {
          "kind": "door",
          "id": "record",
          "emoji": "🎥",
          "label": "Record",
          "href": "https://vlogprompting.com/pit/record.html",
          "tip": "Talk, record, leave with markdown.",
          "anim": "none"
        },
        {
          "kind": "door",
          "id": "studio",
          "emoji": "🎨",
          "label": "Card studio",
          "href": "https://vlogprompting.com/pit/studio.html",
          "tip": "Turn your best line into a quote card.",
          "anim": "none"
        },
        {
          "kind": "door",
          "id": "vlogpit",
          "emoji": "🕳️",
          "label": "The Vlog PIT",
          "href": "https://vlogprompting.com/pit/",
          "tip": "The whole campground.",
          "anim": "none"
        }
      ]
    },
    "bottom-right": {
      "set": {
        "chat": {
          "hub": "https://vlog-chat.shakaverse.workers.dev",
          "label": "Talk to VLOGITHA",
          "name": "VLOGITHA",
          "emoji": "💃",
          "storage": "vlogitha",
          "greeting": "💃 Aloha! VLOGITHA here at Vlog Prompting — an AI agent of the ʻohana, and I say so. Ask about recording a vlog prompt, the transcript, or the card studio.",
          "tip": "A live line to VLOGITHA, the Vlog Prompting desk — an AI agent of the ʻohana. Replies take a moment.",
          "unless": "#vlog-fab, #vlog-fab-mini"
        }
      }
    }
  }
}
